# Supabase Cloud Project Configuration
# Replace with your values from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key-here

# One-Time Device Enrollment Token (Required for initial machine registration to prevent device squatting)
# Provisioned by your administrator using 'SELECT public.create_device_enrollment_token(...)'
# or 'python cloud/provision_device.py'.
ENROLLMENT_TOKEN=your-one-time-enrollment-token-here

# Optional: Dedicated Device Secret Keys (If omitted, the agent automatically generates
# persistent cryptographic keys in agent/device_identity.json)
# DEVICE_API_KEY=
# DASHBOARD_TOKEN=

# Hosted Web Dashboard URL (Live on Vercel)
# Leave blank to use local dashboard (dashboard/index.html).
# When you deploy to Vercel later, set your Vercel production URL here:
# e.g., DASHBOARD_URL=https://pc-health-monitoring.vercel.app
DASHBOARD_URL=

# Polling and Batch Upload Frequencies (in seconds)
COLLECTION_INTERVAL_SECS=5
BATCH_SYNC_INTERVAL_SECS=60
BATCH_SIZE_LIMIT=120
