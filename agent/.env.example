# Supabase Cloud Project Configuration
# Replace with your values from Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key-here

# Hosted Web Dashboard URL (Live on Vercel)
DASHBOARD_URL=https://pc-health-monitoring-dashboard.vercel.app

# Polling and Batch Upload Frequencies (in seconds)
COLLECTION_INTERVAL_SECS=5
BATCH_SYNC_INTERVAL_SECS=60
BATCH_SIZE_LIMIT=120
